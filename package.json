{
  "name": "@lion1ou/skill-ctl",
  "version": "1.2.3",
  "description": "Configuration-driven Agent Skill catalog installer.",
  "license": "MIT",
  "author": "lion1ou",
  "keywords": [
    "agent",
    "skills",
    "cli",
    "cursor",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lion1ou/skillctl.git"
  },
  "homepage": "https://github.com/lion1ou/skillctl#readme",
  "bugs": {
    "url": "https://github.com/lion1ou/skillctl/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.n.lion1ou.tech:16666/"
  },
  "files": [
    "bin/run.js",
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "type": "module",
  "bin": {
    "skill-ctl": "./bin/run.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/ui/assets','dist/ui/assets',{recursive:true})\"",
    "dev": "./bin/dev-session.js",
    "pretest": "pnpm build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "eslint src test --ext .ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test",
    "publish:npm": "npm publish --registry https://npm.n.lion1ou.tech:16666/"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@clack/core": "^0.3.3",
    "@clack/prompts": "^0.7.0",
    "@oclif/core": "^4.0.0",
    "baoyu-chrome-cdp": "^0.1.1",
    "baoyu-md": "^0.1.1",
    "chalk": "^5.3.0",
    "figlet": "^1.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "oclif": {
    "bin": "skill-ctl",
    "dirname": "skill-ctl",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalVersionFlags": [
      "-v"
    ],
    "hooks": {
      "init": "./dist/hooks/init/welcome"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}