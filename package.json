{
  "name": "skillctl",
  "version": "1.0.0",
  "description": "Configuration-driven Agent Skill catalog installer.",
  "type": "module",
  "bin": {
    "skillctl": "./bin/run.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "./bin/dev.js",
    "pretest": "pnpm build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "eslint src test --ext .ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@clack/core": "^0.3.3",
    "@clack/prompts": "^0.7.0",
    "@oclif/core": "^4.0.0",
    "chalk": "^5.3.0",
    "figlet": "^1.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "oclif": {
    "bin": "skillctl",
    "dirname": "skillctl",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "hooks": {
      "init": "./dist/hooks/init/welcome"
    }
  },
  "files": [
    "bin/run.js",
    "dist",
    "README.md"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
